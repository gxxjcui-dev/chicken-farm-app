// 鸡棚 AI 监管系统 - Prisma Schema
// 表结构依据 docs/02_数据库设计.md（7 张表）
// 【Vercel 部署】使用 PostgreSQL：DATABASE_URL="postgresql://user:password@host:5432/chicken_farm?schema=public"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. 批次表
model Batch {
  id            Int      @id @default(autoincrement())
  name          String // 批次名称，如 "2026-01批"
  houseNo       String? @map("houseno") // 棚号
  breed         String? // 品种（如 AA+、ROSS 308）
  startDate     DateTime @db.Date @map("startdate") // 进雏日期（日龄由此推算）
  initialCount  Int @map("initialcount") // 进雏数量
  currentCount  Int? @map("currentcount") // 当前存栏（随死淘更新）
  status        String   @default("active") // active=在养 / finished=已出栏
  note          String?
  createdAt     DateTime @default(now()) @map("createdat")

  envRecords       EnvRecord[]
  feedRecords      FeedRecord[]
  mortalityRecords MortalityRecord[]
  weightRecords    WeightRecord[]
  healthRecords    HealthRecord[]
  alerts           Alert[]

  @@map("batches")
}

// 2. 环境记录表
model EnvRecord {
  id          Int      @id @default(autoincrement())
  batchId     Int? @map("batchid")
  batch       Batch?   @relation(fields: [batchId], references: [id])
  recordDate  DateTime @db.Date @map("recorddate")
  period      String // morning/noon/evening（早/中/晚）
  temperature Float? // °C
  humidity    Float? // %
  ammonia     Float? // 氨气 ppm（可选）
  recorder    String?
  note        String?
  createdAt   DateTime @default(now()) @map("createdat")

  @@index([batchId, recordDate])
  @@map("env_records")
}

// 3. 饲喂记录表
model FeedRecord {
  id         Int      @id @default(autoincrement())
  batchId    Int? @map("batchid")
  batch      Batch?   @relation(fields: [batchId], references: [id])
  recordDate DateTime @db.Date @map("recorddate")
  feedKg     Float? @map("feedkg") // 采食量 kg
  waterL     Float? @map("waterl") // 饮水量 L
  feedType   String? @map("feedtype") // 育雏料/中期料/后期料
  note       String?
  createdAt  DateTime @default(now()) @map("createdat")

  @@index([batchId, recordDate])
  @@map("feed_records")
}

// 4. 死淘记录表
